# Apply manually (do NOT commit the real password) - same pattern as
# 03-helmchart-values/postgresql-ecommerce/.secret.example
#
#   kubectl apply -f secret.yaml
#
# userlist.txt is how pgbouncer authenticates CLIENTS, and it is also what it uses
# to log in to postgres itself.
#
# The password MUST be stored in PLAIN TEXT here, even though auth_type is
# scram-sha-256. Reason: a stored SCRAM verifier is one-way, so pgbouncer could
# authenticate your app but would then be unable to authenticate itself to
# postgres. Plain text lets it do both. The file lives only in this Secret and is
# mounted read-only.
#
# Format is: "username" "password"  (double quotes required)
# Password must be the SAME one as postgres-password in the postgresql-secret.
apiVersion: v1
kind: Secret
metadata:
  name: pgbouncer-userlist
  namespace: postgresql-ecommerce
type: Opaque
stringData:
  userlist.txt: |
    "postgres" "PASSWORD"

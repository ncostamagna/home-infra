# Apply manually (do NOT commit real values):
#   kubectl apply -f secret.yaml
#
# `[password]` must be the SAME password as:
#   - postgres-password in postgresql-secret (03-helmchart-values/postgresql-ecommerce)
#   - the entry in userlist.txt in pgbouncer-userlist (04-apps/pgbouncer)
apiVersion: v1
kind: Secret
metadata:
  name: ecommerce-back-db
  namespace: lapaltech
type: Opaque
stringData:
  # App runtime -> pgbouncer (transaction pooling). Port 6432, not 5432.
  url: "postgres://postgres:[password]@pgbouncer.postgresql-ecommerce.svc.cluster.local:6432/ecommerce?sslmode=disable"
  # Migration job only -> straight to postgres, bypassing the pooler.
  # golang-migrate needs a session-level advisory lock, which transaction pooling breaks.
  direct_url: "postgres://postgres:[password]@postgresql.postgresql-ecommerce.svc.cluster.local:5432/ecommerce?sslmode=disable"
---
apiVersion: v1
kind: Secret
metadata:
  name: ecommerce-back-redis
  namespace: lapaltech
type: Opaque
stringData:
  addr: "address"
  password: "your-redis-password"
---
apiVersion: v1
kind: Secret
metadata:
  name: ecommerce-back-s3
  namespace: lapaltech
type: Opaque
stringData:
  public_url: "https://your-bucket.s3.amazonaws.com"
  access_key_id: "your-access-key-id"
  secret_access_key: "your-secret-access-key"